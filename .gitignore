# Jupyter Notebook Checkpoints (Crucial!)
.ipynb_checkpoints/

# Python cache and compiled files
__pycache__/
*.py[cod]

# Virtual Environments (just in case someone creates one locally)
.env
.venv
env/
venv/

# OS-generated files (Very important for group projects!)
.DS_Store          # macOS
Thumbs.db          # Windows

# Cursor AI files (from your template)
.cursorignore
.cursorindexingignore